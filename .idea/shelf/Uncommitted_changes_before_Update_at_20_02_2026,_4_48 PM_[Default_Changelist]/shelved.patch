+    for (let i = 0; i < midi.track.length; i++) {
+      for (let j = 0; j < midi.track[i].event.length; j++) {
+        const event = midi.track[i].event[j];
+        if (event.metaType === MIDIEventType.SetTempo) {
+          if (typeof event.data === 'number') {
