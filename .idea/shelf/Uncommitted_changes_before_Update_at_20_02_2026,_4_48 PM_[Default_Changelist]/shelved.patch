+          }
+        }
+      }
+    }
+
+    return midi;
+  }
+
+  public customInterpreter:
+    | ((
+        e_type: unknown,
+        arrayBuffer: unknown,
+        metaEventLength: unknown,
+      ) => number)
+    | null = null;
+}
