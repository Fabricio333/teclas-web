lassName=\"bg-white p-6 shadow-sm\">\n                <h3 className=\"text-xl font-heading mb-4\">{item.title}</h3>\n                <p className=\"text-gray-600 mb-4\">{item.desc}</p>\n                <Link href=\"#\" className=\"text-gold hover:underline\">\n                  View Resource\n                </Link>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n    </>\n  )\n}\n\n
